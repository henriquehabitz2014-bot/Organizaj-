        <div class="pomodoro-controles">
          <button class="btn btn-p" id="pomoStart" onclick="pomoToggle()">▶ Iniciar</button>
          <button class="btn btn-s" onclick="pomoReset()">↺ Zerar</button>
          <button class="btn btn-s" onclick="pomoPausaCurta()">☕ 5min</button>
          <button class="btn btn-s" onclick="pomoPausaLonga()">🌴 15min</button>
        </div>
      </div>
      <div class="linha" style="margin-top:1rem">
        <label style="font-size:.8rem;color:var(--txt2)">Foco (min):</label>
        <input class="campo" id="pomoFocoMin" type="number" value="25" min="1" max="90" style="width:70px">
        <label style="font-size:.8rem;color:var(--txt2)">Pausa (min):</label>
        <input class="campo" id="pomoPausaMin" type="number" value="5" min="1" max="30" style="width:70px">
        <button class="btn btn-s" onclick="pomoConfigurar()">Aplicar</button>
      </div>
    </div>
  </div>
</div>

