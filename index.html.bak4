      <div class="orc-resumo">
        <div class="orc-card"><div class="orc-label">Total gasto</div><div class="orc-valor despesa" id="orcTotal">R$ 0</div></div>
        <div class="orc-card"><div class="orc-label">Limite</div><div class="orc-valor" id="orcLimite">Defina um orçamento</div></div>
        <div class="orc-card"><div class="orc-label">Usado</div><div class="orc-valor" id="orcPct">0%</div></div>
      </div>
      <div class="orc-barra" style="height:8px;background:var(--borda);border-radius:4px;margin-bottom:.8rem;overflow:hidden"><div id="orcSaldo" style="height:100%;width:0;border-radius:4px;background:var(--verde);transition:width .3s"></div></div>
      <div class="linha">
        <input class="campo" id="despesaDesc" placeholder="Descrição...">
        <input class="campo" id="despesaVal" type="number" placeholder="Valor" step="0.01">
        <select class="select" id="despesaCat">
          <option value="alimentacao">🍔 Alimentação</option>
          <option value="transporte">🚌 Transporte</option>
          <option value="moradia">🏠 Moradia</option>
          <option value="lazer">🎮 Lazer</option>
          <option value="saude">💊 Saúde</option>
          <option value="educacao">📚 Educação</option>
          <option value="vestuario">👕 Vestuário</option>
          <option value="assinaturas">📱 Assinaturas</option>
          <option value="outros">📦 Outros</option>
        </select>
        <button class="btn btn-p" onclick="addDespesa()">Adicionar</button>
      </div>
      <div class="linha" style="margin-top:.3rem">
        <input class="campo" id="orcamentoMesInput" type="number" placeholder="Orçamento do mês (R$)" step="0.01">
        <button class="btn btn-s" onclick="setOrcamento()">Definir limite</button>
      </div>
      <div id="despesasLista"></div>
      <div style="margin-top:.5rem"><button class="btn btn-d" style="font-size:.72rem" onclick="confirmar('Limpar todas as despesas?',limparDespesas)">Limpar tudo</button></div>
    </div>
  </div>
</div>

