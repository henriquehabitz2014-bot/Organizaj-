<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>OrganizaJá — Organize sua vida de graça</title>
<meta name="description" content="OrganizaJá: app grátis de organização pessoal com 22 ferramentas. Lista de tarefas, hábitos, Pomodoro, orçamento, calendário, estudos e mais. Funciona offline, sem cadastro.">
<meta name="keywords" content="organização pessoal, lista de tarefas, rastreador de hábitos, timer pomodoro, controle financeiro, app grátis, organização para estudantes">
<meta name="author" content="OrganizaJá">
<meta name="robots" content="index, follow">
<meta property="og:title" content="OrganizaJá — Organize sua vida de graça">
<meta property="og:description" content="App grátis com 22 ferramentas de organização pessoal. Tarefas, hábitos, Pomodoro, orçamento e mais.">
<meta property="og:type" content="website">
<meta property="og:locale" content="pt_BR">
<meta name="twitter:card" content="summary">
<meta name="theme-color" content="#6c5ce7">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;700&family=Playfair+Display:ital,wght@0,700;1,400&display=swap" rel="stylesheet">
<link rel="stylesheet" href="style.css">
<link rel="manifest" href="manifest.json">
<script type="application/ld+json">
{"@context":"https://schema.org","@type":"SoftwareApplication","name":"OrganizaJá","applicationCategory":"Productivity","operatingSystem":"Web","offers":{"@type":"Offer","price":"0","priceCurrency":"BRL"},"description":"App gratuito de organização pessoal com 22 ferramentas.","inLanguage":"pt-BR"}
</script>
<script type="application/ld+json">
{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"O OrganizaJá é grátis?","acceptedAnswer":{"@type":"Answer","text":"Sim! Todas as 22 ferramentas são 100% gratuitas."}},{"@type":"Question","name":"Preciso criar conta?","acceptedAnswer":{"@type":"Answer","text":"Não. O OrganizaJá funciona direto no navegador sem cadastro."}},{"@type":"Question","name":"Meus dados ficam salvos?","acceptedAnswer":{"@type":"Answer","text":"Sim. Todos os dados ficam salvos no seu dispositivo (localStorage). Nada é enviado para servidores."}},{"@type":"Question","name":"Funciona offline?","acceptedAnswer":{"@type":"Answer","text":"Sim. Depois de abrir, o app funciona sem internet."}},{"@type":"Question","name":"Quais ferramentas existem?","acceptedAnswer":{"@type":"Answer","text":"Tarefas, Calendário, Estudos, Hábitos, Pomodoro, Metas, Notas, Lembretes, Decisor, Água, Exercícios, Humor, Gratidão, Refeições, Orçamento, Compras, Planejamento Semanal, Contagem Regressiva, Calculadora, Senhas, Leitura, Revisão Semanal, Frases Motivacionais e Painel da Vida."}}]}
</script>
</head>
<body>

<!-- Apoie Banner -->
<div class="apoie-banner" id="apoieBanner">
  <div class="apoie-banner-text"><span class="emoji-pulse">💖</span> Apoie o OrganizaJá!</div>
  <button class="apoie-banner-btn" onclick="abrirPix()">Fazer um PIX</button>
  <button class="apoie-banner-close" onclick="fecharBannerApoie()">✕</button>
</div>

<!-- Install Banner -->
<div class="instalar-banner" id="instalarBanner">
  <span>📱 Instale o OrganizaJá no seu dispositivo</span>
  <button class="instalar-btn" onclick="instalarApp()">Instalar</button>
</div>

<!-- App Layout -->
<div class="app-layout">

<!-- Sidebar Desktop -->
<nav class="sidebar" id="sidebar">
  <div class="sidebar-logo"><span>🚀</span> OrganizaJá</div>
  <div class="sidebar-section">Principal</div>
  <div class="sidebar-item ativo" data-page="inicio" onclick="navegarPara('inicio',this)">
    <div class="s-icon">🏠</div><span>Início</span>
  </div>
  <div class="sidebar-item" data-page="tarefas" onclick="navegarPara('tarefas',this)">
    <div class="s-icon">✅</div><span>Tarefas</span>
  </div>
  <div class="sidebar-item" data-page="calendario" onclick="navegarPara('calendario',this)">
    <div class="s-icon">📅</div><span>Calendário</span>
  </div>
  <div class="sidebar-item" data-page="estudos" onclick="navegarPara('estudos',this)">
    <div class="s-icon">📚</div><span>Estudos</span>
  </div>
  <div class="sidebar-item" data-page="habitos" onclick="navegarPara('habitos',this)">
    <div class="s-icon">🔥</div><span>Hábitos</span>
  </div>
  <div class="sidebar-divider"></div>
  <div class="sidebar-section">Ferramentas</div>
  <div class="sidebar-more-btn" onclick="toggleSidebarTools()">
    <div class="s-icon">🧰</div><span>Mais ferramentas</span><small style="margin-left:auto;font-size:.7rem">▼</small>
  </div>
  <div class="sidebar-tools-panel" id="sidebarTools">
    <div class="sidebar-tool-mini" onclick="navegarPara('pomodoro')">⏱️ Pomodoro</div>
    <div class="sidebar-tool-mini" onclick="navegarPara('metas')">🎯 Metas</div>
    <div class="sidebar-tool-mini" onclick="navegarPara('notas')">📝 Notas</div>
    <div class="sidebar-tool-mini" onclick="navegarPara('lembretes')">🔔 Lembretes</div>
    <div class="sidebar-tool-mini" onclick="navegarPara('decisor')">🗳️ Decisor</div>
    <div class="sidebar-tool-mini" onclick="navegarPara('agua')">💧 Água</div>
    <div class="sidebar-tool-mini" onclick="navegarPara('exercicios')">🏋️ Exercícios</div>
    <div class="sidebar-tool-mini" onclick="navegarPara('humor')">😊 Humor</div>
    <div class="sidebar-tool-mini" onclick="navegarPara('gratidao')">🙏 Gratidão</div>
    <div class="sidebar-tool-mini" onclick="navegarPara('refeicoes')">🍽️ Refeições</div>
    <div class="sidebar-tool-mini" onclick="navegarPara('orcamento')">💰 Orçamento</div>
    <div class="sidebar-tool-mini" onclick="navegarPara('compras')">🛒 Compras</div>
    <div class="sidebar-tool-mini" onclick="navegarPara('planejamento')">📅 Semanal</div>
    <div class="sidebar-tool-mini" onclick="navegarPara('regressiva')">⏰ Regressiva</div>
    <div class="sidebar-tool-mini" onclick="navegarPara('calculadora')">📐 Calculadora</div>
    <div class="sidebar-tool-mini" onclick="navegarPara('senhas')">🔐 Senhas</div>
    <div class="sidebar-tool-mini" onclick="navegarPara('leitura')">📖 Leitura</div>
    <div class="sidebar-tool-mini" onclick="navegarPara('revisao')">📊 Revisão</div>
    <div class="sidebar-tool-mini" onclick="navegarPara('frases')">💭 Frases</div>
    <div class="sidebar-tool-mini" onclick="navegarPara('vida')">🌟 Painel da Vida</div>
  </div>
</nav>

<!-- Main Area -->
<div class="main-area">

<!-- Top Bar -->
<div class="topbar">
  <div class="topbar-left">
    <button class="topbar-btn" id="menuToggle" onclick="toggleSidebar()" style="display:none">☰</button>
    <div class="topbar-title" id="topbarTitle">Início</div>
  </div>
  <div class="topbar-botoes">
    <button class="topbar-btn" onclick="abrirBusca()" title="Buscar">🔍</button>
    <button class="topbar-btn" onclick="toggleTema()" title="Tema" id="temaBtn">🌙</button>
    <button class="topbar-btn apoie-btn" onclick="abrirPix()" title="Apoie">💖</button>
  </div>
</div>

<!-- Search Overlay -->
<div class="busca-overlay" id="buscaOverlay" onclick="fecharBusca(event)">
  <div class="busca-box">
    <div class="busca-input-wrap">
      <span>🔍</span>
      <input type="text" id="buscaInput" placeholder="Buscar ferramenta ou tarefa..." oninput="buscarTudo(this.value)">
    </div>
    <div class="busca-resultados" id="buscaResultados"></div>
  </div>
</div>

<!-- ======== PAGE: INICIO/DASHBOARD ======== -->
<div class="page ativo" id="page-inicio">
  <div class="content-wrap">

    <!-- HERO: Saudação + Data -->
    <div class="dash-hero">
      <div class="dash-hero-text">
        <div class="dash-greeting" id="dashGreeting">Bom dia! 👋</div>
        <div class="dash-date" id="dashDate"></div>
      </div>
      <div class="dash-hero-status" id="dashHeroStatus"></div>
    </div>

    <!-- CARDS: Resumo rápido -->
    <div class="dash-cards" id="dashCards"></div>

    <!-- ATALHOS RÁPIDOS -->
    <div class="dash-shortcuts" id="dashShortcuts">
      <button class="dash-shortcut" onclick="dashQuickProva()">
        <span class="ds-icon">📝</span>
        <span class="ds-label">Prova</span>
      </button>
      <button class="dash-shortcut" onclick="dashQuickTrabalho()">
        <span class="ds-icon">📄</span>
        <span class="ds-label">Trabalho</span>
      </button>
      <button class="dash-shortcut" onclick="dashQuickTarefa()">
        <span class="ds-icon">✅</span>
        <span class="ds-label">Tarefa</span>
      </button>
      <button class="dash-shortcut" onclick="dashQuickEvento()">
        <span class="ds-icon">🔔</span>
        <span class="ds-label">Evento</span>
      </button>
    </div>

    <!-- TAREFAS DE HOJE -->
    <div class="dash-section">
      <div class="dash-sec-header">
        <h3>📋 Tarefas de Hoje <span class="dash-count" id="dashTarefasCount"></span></h3>
        <button class="dash-sec-btn" onclick="navegarPara('tarefas')">Ver todas →</button>
      </div>
      <div id="dashTarefasHoje"></div>
    </div>

    <!-- ATRASADAS -->
    <div class="dash-section dash-section-alert" id="dashAtrasadasSection" style="display:none">
      <div class="dash-sec-header">
        <h3>🚨 Atrasadas <span class="dash-count dash-count-red" id="dashAtrasadasCount"></span></h3>
      </div>
      <div id="dashAtrasadas"></div>
    </div>

    <!-- PRÓXIMA PROVA + TRABALHO -->
    <div class="dash-upcoming-grid">
      <div class="dash-upcoming-card" id="dashProximaProva">
        <div class="duc-header">📝 Próxima Prova</div>
        <div class="duc-body" id="dashProximaProvaBody"></div>
      </div>
      <div class="dash-upcoming-card" id="dashProximoTrabalho">
        <div class="duc-header">📄 Próximo Trabalho</div>
        <div class="duc-body" id="dashProximoTrabalhoBody"></div>
      </div>
    </div>

    <!-- PRÓXIMO COMPROMISSO -->
    <div class="dash-section">
      <div class="dash-sec-header">
        <h3>📅 Próximo Compromisso</h3>
      </div>
      <div id="dashProximoCompromisso"></div>
    </div>

    <!-- HÁBITOS DE HOJE -->
    <div class="dash-section">
      <div class="dash-sec-header">
        <h3>🔥 Hábitos de Hoje</h3>
        <button class="dash-sec-btn" onclick="navegarPara('habitos')">Ver todos →</button>
      </div>
      <div id="dashHabitosHoje"></div>
    </div>

    <!-- PROGRESSO DA SEMANA -->
    <div class="dash-section">
      <div class="dash-sec-header">
        <h3>📊 Progresso da Semana</h3>
      </div>
      <div class="dash-progress-grid" id="dashProgressoSemana"></div>
    </div>

    <!-- Dicas Rodape -->
    <div class="dicas-rodape">
      <div class="dica-card" id="dicaDoDia">
        <div class="dica-icone">💡</div>
        <div class="dica-conteudo">
          <h3 class="dica-titulo">Dica do Dia</h3>
          <p class="dica-texto" id="dicaTexto">Carregando dica...</p>
          <button class="dica-btn" onclick="novaDica()">🔄 Outra dica</button>
        </div>
      </div>
      <div class="dica-card">
        <div class="dica-icone">🔥</div>
        <div class="dica-conteudo">
          <h3 class="dica-titulo">Motivação Rápida</h3>
          <p class="dica-texto" id="motivacaoTexto">Carregando...</p>
          <button class="dica-btn" onclick="novaMotivacao()">⚡ Nova motivação</button>
        </div>
      </div>
      <div class="dica-card">
        <div class="dica-icone">🎯</div>
        <div class="dica-conteudo">
          <h3 class="dica-titulo">Desafio do Dia</h3>
          <p class="dica-texto" id="desafioTexto">Carregando...</p>
          <button class="dica-btn" onclick="novoDesafio()">🏆 Novo desafio</button>
        </div>
      </div>
      <div class="dica-card dica-guia">
        <div class="dica-icone">📖</div>
        <div class="dica-conteudo">
          <h3 class="dica-titulo">Como Usar Este App</h3>
          <div class="guia-grid">
            <div class="guia-item" onclick="navegarPara('tarefas')"><span>✅</span> <span>Tarefas: liste e marque o que precisa fazer</span></div>
            <div class="guia-item" onclick="navegarPara('pomodoro')"><span>🍅</span> <span>Pomodoro: foque 25 min, descanse 5</span></div>
            <div class="guia-item" onclick="navegarPara('habitos')"><span>📅</span> <span>Hábitos: acompanhe sua rotina semanal</span></div>
            <div class="guia-item" onclick="navegarPara('orcamento')"><span>💰</span> <span>Orçamento: controle receitas e despesas</span></div>
            <div class="guia-item" onclick="navegarPara('agua')"><span>💧</span> <span>Água: marque os copos que você bebeu</span></div>
            <div class="guia-item" onclick="navegarPara('gratidao')"><span>🙏</span> <span>Gratidão: anote o que te faz grato</span></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- ======== PAGE: TAREFAS ======== -->
<div class="page" id="page-tarefas">
  <div class="content-wrap">
    <div class="secao">
      <h2 class="secao-titulo">✅ Tarefas</h2>

      <!-- CRIACAO RAPIDA -->
      <div class="tk-quick">
        <input class="tk-quick-input" id="tarefaInput" placeholder="O que você precisa fazer? (Enter para salvar)" onkeydown="tarefaQuickKey(event)" autocomplete="off">
        <button class="tk-quick-add" onclick="addTarefa()" title="Adicionar tarefa">+</button>
      </div>
      <div class="tk-quick-row">
        <button class="tk-chip-day ativo" id="tkDayHoje" onclick="tarefaSetDia('hoje')">Hoje</button>
        <button class="tk-chip-day" id="tkDayAmanha" onclick="tarefaSetDia('amanha')">Amanhã</button>
        <button class="tk-chip-day" id="tkDaySem" onclick="tarefaSetDia('sem')">Sem data</button>
        <input class="campo tk-mini" id="tarefaData" type="date" onchange="tarefaSetDia('custom')">
        <select class="select tk-mini" id="tarefaPrio" title="Prioridade">
          <option value="media">🟡 Média</option>
          <option value="alta">🔴 Alta</option>
          <option value="baixa">🟢 Baixa</option>
        </select>
        <button class="tk-more-btn" id="tkMoreBtn" onclick="toggleTarefaAvancado()">⚙️ Mais campos</button>
      </div>

      <!-- CAMPOS AVANCADOS -->
      <div class="tk-adv" id="tarefaAvancado">
        <div class="tk-adv-grid">
          <div class="tk-field">
            <label class="tk-lbl" for="tarefaMateria">📚 Matéria</label>
            <input class="campo" id="tarefaMateria" list="tarefaMateriaList" placeholder="Ex: Matemática">
            <datalist id="tarefaMateriaList"></datalist>
          </div>
          <div class="tk-field">
            <label class="tk-lbl" for="tarefaHora">🕐 Horário (opcional)</label>
            <input class="campo" id="tarefaHora" type="time">
          </div>
          <div class="tk-field">
            <label class="tk-lbl" for="tarefaCat">🏷️ Categoria</label>
            <select class="select" id="tarefaCat">
              <option value="">Sem categoria</option>
              <option value="estudo">📖 Estudo</option>
              <option value="trabalho">💼 Trabalho</option>
              <option value="pessoal">🏠 Pessoal</option>
              <option value="saude">💚 Saúde</option>
              <option value="financas">💰 Finanças</option>
              <option value="outros">📦 Outros</option>
            </select>
          </div>
          <div class="tk-field">
            <label class="tk-lbl" for="tarefaStatus">📊 Status</label>
            <select class="select" id="tarefaStatus">
              <option value="pendente">⏳ Pendente</option>
              <option value="fazendo">🔄 Fazendo</option>
              <option value="concluida">✅ Concluída</option>
            </select>
          </div>
        </div>
        <div class="tk-field">
          <label class="tk-lbl" for="tarefaDesc">📝 Descrição</label>
          <textarea class="campo tk-ta" id="tarefaDesc" rows="2" placeholder="Detalhe o que precisa ser feito..."></textarea>
        </div>
        <div class="tk-field">
          <label class="tk-lbl" for="tarefaObs">📌 Observações</label>
          <textarea class="campo tk-ta" id="tarefaObs" rows="2" placeholder="Anotações extras, materiais, links..."></textarea>
        </div>
        <div class="tk-adv-actions">
          <button class="btn btn-s" onclick="limparFormTarefa()">Limpar campos</button>
          <button class="btn btn-p" onclick="addTarefa()">Adicionar tarefa</button>
        </div>
      </div>

      <!-- PESQUISA -->
      <div class="tk-search">
        <span class="tk-search-ico">🔍</span>
        <input type="text" id="tarefaPesquisa" placeholder="Pesquisar por título, descrição, matéria ou observação..." oninput="renderTarefas()">
        <button class="tk-search-clear" onclick="limparPesquisaTarefa()" title="Limpar pesquisa">✕</button>
      </div>

      <!-- FILTROS -->
      <div class="tk-filtros" id="tarefaFiltros">
        <button class="tk-chip" data-f="todas" onclick="filtroTarefa('todas')">Todas <span class="tk-chip-n" id="tkfN-todas">0</span></button>
        <button class="tk-chip" data-f="hoje" onclick="filtroTarefa('hoje')">📅 Hoje <span class="tk-chip-n" id="tkfN-hoje">0</span></button>
        <button class="tk-chip" data-f="amanha" onclick="filtroTarefa('amanha')">➡️ Amanhã <span class="tk-chip-n" id="tkfN-amanha">0</span></button>
        <button class="tk-chip" data-f="semana" onclick="filtroTarefa('semana')">🗓️ Esta semana <span class="tk-chip-n" id="tkfN-semana">0</span></button>
        <button class="tk-chip tk-chip-alert" data-f="atrasadas" onclick="filtroTarefa('atrasadas')">🚨 Atrasadas <span class="tk-chip-n" id="tkfN-atrasadas">0</span></button>
        <button class="tk-chip" data-f="concluidas" onclick="filtroTarefa('concluidas')">✅ Concluídas <span class="tk-chip-n" id="tkfN-concluidas">0</span></button>
      </div>

      <!-- ORDENACAO -->
      <div class="tk-ordem">
        <span class="tk-ordem-lbl">Ordenar:</span>
        <select class="select tk-ordem-sel" id="tarefaOrdem" onchange="ordenarTarefas(this.value)">
          <option value="data">📅 Data de entrega</option>
          <option value="prio">🔥 Prioridade</option>
          <option value="cat">🏷️ Categoria</option>
          <option value="materia">📚 Matéria</option>
          <option value="status">📊 Status</option>
          <option value="titulo">🔤 Título (A-Z)</option>
          <option value="criacao">🆕 Mais recentes</option>
        </select>
        <button class="tk-ordem-dir" id="tarefaOrdemDir" onclick="inverterOrdemTarefas()" title="Inverter ordem">↑↓</button>
      </div>

      <div class="tk-resumo" id="tarefaResumo"></div>
      <ul class="lista tk-lista" id="tarefasLista"></ul>
      <div class="tk-footer-actions">
        <button class="btn btn-d" onclick="confirmar('Excluir todas as tarefas concluídas?',limparTarefas)">🗑️ Limpar concluídas</button>
      </div>
    </div>
  </div>
</div>

<!-- ======== PAGE: CALENDARIO ======== -->
<div class="page" id="page-calendario">
  <div class="content-wrap">
    <div class="secao">
      <h2 class="secao-titulo">📅 Calendário</h2>
      <div class="cal-view-toggle">
        <button class="ativo" onclick="setCalView('mes',this)">Mês</button>
        <button onclick="setCalView('semana',this)">Semana</button>
      </div>
      <div class="cal-header">
        <button onclick="calNav(-1)">◀</button>
        <h3 id="calTitulo"></h3>
        <button onclick="calNav(1)">▶</button>
        <button class="btn btn-s" style="margin-left:.5rem;font-size:.72rem" onclick="calHoje()">Hoje</button>
      </div>
      <div id="calCorpo"></div>
    </div>
  </div>
</div>

<!-- ======== PAGE: ESTUDOS ======== -->
<div class="page" id="page-estudos">
  <div class="content-wrap">
    <div class="secao">
      <h2 class="secao-titulo">📚 Área de Estudos</h2>
      <div class="linha">
        <input class="campo" id="materiaInput" placeholder="Matéria...">
        <input class="campo" id="materiaCor" type="color" value="#6c5ce7" style="width:40px;height:36px;padding:2px">
        <button class="btn btn-p" onclick="addMateria()">Adicionar</button>
      </div>
      <div class="estudos-materias" id="materiasGrid"></div>
    </div>
    <div class="secao">
      <h3 style="font-size:1rem;font-weight:700;margin-bottom:.5rem">📝 Provas</h3>
      <div class="linha">
        <input class="campo" id="provaInput" placeholder="Prova de...">
        <input class="campo" id="provaMateria" placeholder="Matéria" style="width:100px">
        <input class="campo" id="provaData" type="date" style="width:130px">
        <button class="btn btn-p" onclick="addProva()">Adicionar</button>
      </div>
      <div class="estudos-provas" id="provasLista"></div>
    </div>
    <div class="secao">
      <h3 style="font-size:1rem;font-weight:700;margin-bottom:.5rem">📄 Trabalhos</h3>
      <div class="linha">
        <input class="campo" id="trabInput" placeholder="Trabalho...">
        <input class="campo" id="trabMateria" placeholder="Matéria" style="width:100px">
        <input class="campo" id="trabData" type="date" style="width:130px">
        <button class="btn btn-p" onclick="addTrabalho()">Adicionar</button>
      </div>
      <div class="estudos-trabalhos" id="trabalhosLista"></div>
    </div>
  </div>
</div>

<!-- ======== PAGE: HABITOS ======== -->
<div class="page" id="page-habitos">
  <div class="content-wrap">
    <div class="secao">
