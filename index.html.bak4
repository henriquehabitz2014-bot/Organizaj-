      <div class="senha-display" id="senhaDisplay">Clique para gerar</div>
      <div class="senha-opcoes">
        <label>Tamanho: <input type="range" id="senhaTam" min="8" max="32" value="16" oninput="document.getElementById('senhaTamVal').textContent=this.value"><span id="senhaTamVal">16</span></label>
        <label><input type="checkbox" id="senhaMaius" checked> A-Z</label>
        <label><input type="checkbox" id="senhaMinus" checked> a-z</label>
        <label><input type="checkbox" id="senhaNum" checked> 0-9</label>
        <label><input type="checkbox" id="senhaSimb"> !@#</label>
      </div>
      <button class="btn btn-p" onclick="gerarSenha()">Gerar senha</button> <button class="btn btn-s" onclick="copiarSenha()">📋 Copiar</button>
      <hr style="border:0;border-top:1px solid var(--borda);margin:1rem 0">
      <h3 style="font-size:.92rem;margin-bottom:.5rem">💾 Salvar senha</h3>
      <div class="linha">
        <input class="campo" id="senhaSite" placeholder="Site ou app...">
        <input class="campo" id="senhaUser" placeholder="Usuário...">
        <input class="campo" id="senhaPw" type="password" placeholder="Senha...">
        <button class="btn btn-p" onclick="addSenha()">Salvar</button>
      </div>
      <div id="senhasLista"></div>
    </div>
  </div>
</div>

