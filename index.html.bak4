    <div class="secao">
      <h2 class="secao-titulo">🌟 Painel da Vida</h2>
      <p class="secao-desc" style="text-align:center;color:var(--txt3);font-size:.82rem;margin-bottom:.5rem">Veja como está a organização da sua vida em um só lugar</p>
      <div class="vida-container" id="vidaPainel">
        <div class="vida-score-wrap" id="vidaScoreWrap">
          <svg viewBox="0 0 200 200"><circle class="vida-score-bg" cx="100" cy="100" r="85"/><circle class="vida-score-bar" id="vidaScoreBar" cx="100" cy="100" r="85" stroke-dasharray="534" stroke-dashoffset="534" stroke="var(--cor)"/></svg>
          <div class="vida-score-num" id="vidaScoreNum">0</div>
          <div class="vida-score-label">de 100</div>
        </div>
        <div class="vida-nivel n0" id="vidaNivel">Começando</div>
        <div class="vida-comp" id="vidaComp"></div>
        <div class="vida-cats" id="vidaCats"></div>
        <div id="vidaDicas"></div>
        <div class="vida-streak" id="vidaStreak"></div>
        <div class="vida-hist" id="vidaHist"></div>
        <div class="vida-refresh" onclick="renderVida()" style="cursor:pointer;padding:.5rem 1rem;background:var(--card);border-radius:var(--raio);border:1px solid var(--borda);display:inline-block;margin-top:.5rem;font-size:.8rem;transition:var(--transition)" onmouseover="this.style.background='var(--card2)'" onmouseout="this.style.background='var(--card)'">🔄 Recalcular</div>
      </div>
    </div>
  </div>
</div>

<!-- SEO Content (hidden) -->
<section style="display:none" aria-hidden="true">
  <h2>Ferramentas de organização pessoal gratuitas</h2>
  <p>O OrganizaJá oferece 22 ferramentas gratuitas para organizar toda a sua vida.</p>
</section>

<section class="secao" style="text-align:center;padding:2rem 1rem;max-width:800px;margin:2rem auto">
  <h2 style="font-size:1.1rem;font-weight:700;margin-bottom:.8rem">Por que milhares confiam no OrganizaJá</h2>
  <div style="display:flex;gap:1rem;flex-wrap:wrap;justify-content:center">
    <div style="flex:1;min-width:140px;padding:1rem;background:var(--card);border:1px solid var(--borda);border-radius:12px">
      <div style="font-size:1.5rem;margin-bottom:.3rem">🛡</div>
      <strong style="font-size:.9rem;display:block">Dados privados</strong>
      <span style="font-size:.8rem;color:var(--txt2)">Tudo fica no seu aparelho. Nada vai para servidores.</span>
    </div>
    <div style="flex:1;min-width:140px;padding:1rem;background:var(--card);border:1px solid var(--borda);border-radius:12px">
      <div style="font-size:1.5rem;margin-bottom:.3rem">⚡</div>
      <strong style="font-size:.9rem;display:block">Sem cadastro</strong>
      <span style="font-size:.8rem;color:var(--txt2)">Abra e use. Não pedimos email, senha nem cartão.</span>
    </div>
    <div style="flex:1;min-width:140px;padding:1rem;background:var(--card);border:1px solid var(--borda);border-radius:12px">
      <div style="font-size:1.5rem;margin-bottom:.3rem">📱</div>
      <strong style="font-size:.9rem;display:block">Celular e PC</strong>
      <span style="font-size:.8rem;color:var(--txt2)">Funciona em qualquer navegador. Responsivo e rápido.</span>
    </div>
    <div style="flex:1;min-width:140px;padding:1rem;background:var(--card);border:1px solid var(--borda);border-radius:12px">
      <div style="font-size:1.5rem;margin-bottom:.3rem">📴</div>
      <strong style="font-size:.9rem;display:block">Funciona offline</strong>
      <span style="font-size:.8rem;color:var(--txt2)">Depois de abrir, funciona sem internet. Seus dados estão lá.</span>
    </div>
  </div>
</section>

</div><!-- /main-area -->

<!-- Bottom Bar Mobile -->
<nav class="bottombar" id="bottombar">
  <div class="bottombar-item ativo" data-page="inicio" onclick="navegarPara('inicio',this)">
    <div class="b-icon">🏠</div><span>Início</span>
  </div>
  <div class="bottombar-item" data-page="tarefas" onclick="navegarPara('tarefas',this)">
    <div class="b-icon">✅</div><span>Tarefas</span>
  </div>
  <div class="bottombar-item" data-page="calendario" onclick="navegarPara('calendario',this)">
    <div class="b-icon">📅</div><span>Calendário</span>
  </div>
  <div class="bottombar-item" data-page="estudos" onclick="navegarPara('estudos',this)">
    <div class="b-icon">📚</div><span>Estudos</span>
  </div>
  <div class="bottombar-item" data-page="habitos" onclick="navegarPara('habitos',this)">
    <div class="b-icon">🔥</div><span>Hábitos</span>
  </div>
  <div class="bottombar-item bottombar-more" onclick="toggleMoreSheet()">
    <div class="b-icon">🧰</div><span>Mais</span>
  </div>
</nav>

<!-- More Sheet (mobile) -->
<div class="bottombar-more-sheet" id="moreSheet">
  <div class="sheet-handle"></div>
  <div class="sheet-grid">
    <div class="sheet-tool" onclick="navegarPara('pomodoro');fecharMoreSheet()"><div class="st-icon">⏱️</div>Pomodoro</div>
    <div class="sheet-tool" onclick="navegarPara('metas');fecharMoreSheet()"><div class="st-icon">🎯</div>Metas</div>
    <div class="sheet-tool" onclick="navegarPara('notas');fecharMoreSheet()"><div class="st-icon">📝</div>Notas</div>
    <div class="sheet-tool" onclick="navegarPara('lembretes');fecharMoreSheet()"><div class="st-icon">🔔</div>Lembretes</div>
    <div class="sheet-tool" onclick="navegarPara('decisor');fecharMoreSheet()"><div class="st-icon">🗳️</div>Decisor</div>
    <div class="sheet-tool" onclick="navegarPara('agua');fecharMoreSheet()"><div class="st-icon">💧</div>Água</div>
    <div class="sheet-tool" onclick="navegarPara('exercicios');fecharMoreSheet()"><div class="st-icon">🏋️</div>Exercícios</div>
    <div class="sheet-tool" onclick="navegarPara('humor');fecharMoreSheet()"><div class="st-icon">😊</div>Humor</div>
    <div class="sheet-tool" onclick="navegarPara('gratidao');fecharMoreSheet()"><div class="st-icon">🙏</div>Gratidão</div>
    <div class="sheet-tool" onclick="navegarPara('refeicoes');fecharMoreSheet()"><div class="st-icon">🍽️</div>Refeições</div>
    <div class="sheet-tool" onclick="navegarPara('orcamento');fecharMoreSheet()"><div class="st-icon">💰</div>Orçamento</div>
    <div class="sheet-tool" onclick="navegarPara('compras');fecharMoreSheet()"><div class="st-icon">🛒</div>Compras</div>
    <div class="sheet-tool" onclick="navegarPara('planejamento');fecharMoreSheet()"><div class="st-icon">📅</div>Semanal</div>
    <div class="sheet-tool" onclick="navegarPara('regressiva');fecharMoreSheet()"><div class="st-icon">⏰</div>Regressiva</div>
    <div class="sheet-tool" onclick="navegarPara('calculadora');fecharMoreSheet()"><div class="st-icon">📐</div>Calculadora</div>
    <div class="sheet-tool" onclick="navegarPara('senhas');fecharMoreSheet()"><div class="st-icon">🔐</div>Senhas</div>
    <div class="sheet-tool" onclick="navegarPara('leitura');fecharMoreSheet()"><div class="st-icon">📖</div>Leitura</div>
    <div class="sheet-tool" onclick="navegarPara('revisao');fecharMoreSheet()"><div class="st-icon">📊</div>Revisão</div>
    <div class="sheet-tool" onclick="navegarPara('frases');fecharMoreSheet()"><div class="st-icon">💭</div>Frases</div>
    <div class="sheet-tool" onclick="navegarPara('vida');fecharMoreSheet()"><div class="st-icon">🌟</div>Painel da Vida</div>
  </div>
</div>

</div><!-- /app-layout -->

<!-- Pix Modal -->
<div class="pix-modal-bg" id="pixModal" onclick="fecharPix(event)">
  <div class="pix-modal">
    <button class="pix-fechar" onclick="fecharPixBtn()">✕</button>
    <div class="pix-coracao">💖💖💖</div>
    <h3>Apoie o OrganizaJá</h3>
    <p>Se este app te ajuda, considere fazer uma doação para manter o projeto vivo. Qualquer valor faz diferença! 🙏</p>
    <div class="pix-chave-box">
      <span class="pix-icon">📧</span>
      <span class="pix-email">henriquehabitz@gmail.com</span>
    </div>
    <button class="pix-copiar" onclick="copiarPix()">📋 Copiar chave PIX</button>
  </div>
</div>

<!-- Modal Editar Tarefa -->
<div class="tk-modal-bg" id="tarefaEditModal" onclick="fecharEdicaoTarefa(event)">
  <div class="tk-modal" onclick="event.stopPropagation()">
    <div class="tk-modal-head">
      <h3>✏️ Editar tarefa</h3>
      <button class="tk-modal-x" onclick="fecharEdicaoTarefa()" title="Fechar">✕</button>
    </div>
    <div class="tk-modal-body">
      <div class="tk-field">
        <label class="tk-lbl" for="edTarefaTitulo">✅ Título *</label>
        <input class="campo" id="edTarefaTitulo" placeholder="Título da tarefa">
      </div>
      <div class="tk-field">
        <label class="tk-lbl" for="edTarefaDesc">📝 Descrição</label>
        <textarea class="campo tk-ta" id="edTarefaDesc" rows="3" placeholder="Detalhes da tarefa"></textarea>
      </div>
      <div class="tk-adv-grid">
        <div class="tk-field">
          <label class="tk-lbl" for="edTarefaMateria">📚 Matéria</label>
          <input class="campo" id="edTarefaMateria" list="tarefaMateriaList" placeholder="Ex: História">
        </div>
        <div class="tk-field">
          <label class="tk-lbl" for="edTarefaData">📅 Data de entrega</label>
          <input class="campo" id="edTarefaData" type="date">
        </div>
        <div class="tk-field">
          <label class="tk-lbl" for="edTarefaHora">🕐 Horário (opcional)</label>
          <input class="campo" id="edTarefaHora" type="time">
        </div>
        <div class="tk-field">
          <label class="tk-lbl" for="edTarefaPrio">🔥 Prioridade</label>
          <select class="select" id="edTarefaPrio">
            <option value="alta">🔴 Alta</option>
            <option value="media">🟡 Média</option>
            <option value="baixa">🟢 Baixa</option>
          </select>
        </div>
        <div class="tk-field">
          <label class="tk-lbl" for="edTarefaCat">🏷️ Categoria</label>
          <select class="select" id="edTarefaCat">
            <option value="">Sem categoria</option>
            <option value="estudo">📖 Estudo</option>
            <option value="trabalho">💼 Trabalho</option>
            <option value="pessoal">🏠 Pessoal</option>
            <option value="saude">💚 Saúde</option>
            <option value="financas">💰 Finanças</option>
            <option value="outros">📦 Outros</option>
          </select>
        </div>
        <div class="tk-field">
          <label class="tk-lbl" for="edTarefaStatus">📊 Status</label>
          <select class="select" id="edTarefaStatus">
            <option value="pendente">⏳ Pendente</option>
            <option value="fazendo">🔄 Fazendo</option>
            <option value="concluida">✅ Concluída</option>
          </select>
        </div>
      </div>
      <div class="tk-field">
        <label class="tk-lbl" for="edTarefaObs">📌 Observações</label>
        <textarea class="campo tk-ta" id="edTarefaObs" rows="2" placeholder="Anotações extras"></textarea>
      </div>
    </div>
    <div class="tk-modal-foot">
      <button class="btn btn-s" onclick="fecharEdicaoTarefa()">Cancelar</button>
      <button class="btn btn-p" onclick="salvarEdicaoTarefa()">💾 Salvar alterações</button>
    </div>
  </div>
</div>

<!-- Confirm Modal -->
<div class="modal-overlay" id="modalOverlay">
  <div class="modal-box">
    <h3 id="modalTitulo">Confirmar</h3>
    <p id="modalMsg">Tem certeza?</p>
    <div class="modal-botoes">
      <button class="btn btn-s" onclick="fecharModal()">Cancelar</button>
      <button class="btn btn-d" id="modalConfirmar" onclick="confirmarAcao()">Confirmar</button>
    </div>
  </div>
</div>

<!-- Scroll Top -->
<button class="scroll-top" id="scrollTopBtn" onclick="window.scrollTo({top:0,behavior:'smooth'})">⬆</button>

<!-- Footer -->
<footer class="rodape" role="contentinfo">
  <p>OrganizaJá 2025 — Organize sua vida de graça</p>
  <p style="font-size:.72rem">Todos os dados ficam salvos no seu dispositivo. Nada é enviado para servidores.</p>
  <div class="visit-counter" id="visitCounter"><span class="vc-icon">👀</span><span class="vc-num" id="visitNum">0</span> visitas</div>
  <div class="rodape-links">
    <a href="#" onclick="navegarPara('tarefas');return false">Tarefas</a>
    <a href="#" onclick="navegarPara('habitos');return false">Hábitos</a>
    <a href="#" onclick="navegarPara('orcamento');return false">Orçamento</a>
    <a href="#" onclick="navegarPara('pomodoro');return false">Pomodoro</a>
    <a href="#" onclick="navegarPara('metas');return false">Metas</a>
    <a href="#" onclick="navegarPara('agua');return false">Água</a>
  </div>
</footer>

